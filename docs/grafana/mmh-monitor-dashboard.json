{
  "__inputs": [
    {
      "name": "DS_INFLUXDB",
      "label": "InfluxDB",
      "description": "InfluxDB com o bucket mmh_health",
      "type": "datasource",
      "pluginId": "influxdb",
      "pluginName": "InfluxDB"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "influxdb",
      "name": "InfluxDB",
      "version": "1.0.0"
    }
  ],
  "title": "MMH Monitor — Saúde dos sites",
  "uid": "mmh-monitor-health",
  "tags": [
    "mmh"
  ],
  "timezone": "browser",
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "site",
        "label": "Site",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "${DS_INFLUXDB}"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"mmh_health\", tag: \"site\", start: -30d)",
        "definition": "schema.tagValues(bucket: \"mmh_health\", tag: \"site\", start: -30d)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Saúde por site (agora)",
      "description": "Último envio de cada site na última hora. Site que some desta tabela parou de reportar (veja o Kuma).",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "refId": "A",
          "query": "from(bucket: \"mmh_health\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"mmh_health\" and (r._field == \"level\" or r._field == \"msg\"))\n  |> filter(fn: (r) => contains(value: r.site, set: ${site:json}))\n  |> group(columns: [\"site\", \"_field\"])\n  |> last()\n  |> keep(columns: [\"site\", \"version\", \"ha_version\", \"_field\", \"_value\", \"_time\"])\n  |> group()\n  |> pivot(rowKey: [\"site\", \"version\", \"ha_version\", \"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> sort(columns: [\"level\"], desc: true)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "level"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Nível"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "-1": {
                        "text": "Não monitorado",
                        "color": "text",
                        "index": 0
                      },
                      "0": {
                        "text": "OK",
                        "color": "green",
                        "index": 1
                      },
                      "1": {
                        "text": "Atenção",
                        "color": "yellow",
                        "index": 2
                      },
                      "2": {
                        "text": "Crítico",
                        "color": "red",
                        "index": 3
                      }
                    }
                  }
                ]
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 0
                    },
                    {
                      "color": "yellow",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 2
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "custom.width",
                "value": 130
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "_time"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Último envio"
              },
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              },
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "site"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Site"
              },
              {
                "id": "custom.width",
                "value": 160
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "msg"
